# Copia este archivo como .env y completa con los datos de tu proyecto Supabase
# (Supabase > Project Settings > API Keys)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Supabase > Connect > Connection String > Session pooler (con la contraseña)
DATABASE_URL=postgresql://postgres.TU-PROYECTO:TU-CONTRASEÑA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
